{
  "name": "between-gigs-2",
  "version": "0.2.0",
  "private": true,
  "description": "Between Gigs 2.0: the client-facing product on the Between Gigs Design System.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/studio-source.mjs && next build",
    "build:server": "node scripts/server-build.mjs",
    "check:server": "node scripts/check-bundle.mjs && node scripts/check-server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:values": "node scripts/check-raw-values.mjs",
    "qa": "node scripts/qa/run.mjs",
    "qa:screens": "node scripts/qa/run.mjs screens",
    "qa:axe": "node scripts/qa/run.mjs axe",
    "qa:flow": "node scripts/qa/run.mjs flow",
    "qa:rules": "node scripts/qa/run.mjs rules",
    "thumbs": "node scripts/preview-thumbs.mjs",
    "og": "node scripts/og-images.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:values && pnpm test && pnpm build && node scripts/check-pages.mjs && pnpm qa && pnpm build:server && pnpm check:server",
    "sync:ds": "scripts/sync-design-system.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/react": "6.18.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "lucide-react": "1.31.0",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.15.30",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.10.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.56.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
