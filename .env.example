# Copy to .env.local for local development. Never commit real values to .env.local.

# Clerk sign-in. The publishable key is public (it's in every page's JavaScript). Leave it empty to use
# the sample email-code login, which QA and the demo switcher rely on.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# CLERK_SECRET_KEY is server-only. This app is a static export with no server, so it doesn't use it:
# it belongs in the Worker API's secrets (wrangler secret put CLERK_SECRET_KEY), never here or in GitHub Pages.

# Optional: GitHub Pages sub-path.
# NEXT_PUBLIC_BASE_PATH=/between-gig-2.0
